{% extends "base.html" %}
{% block titulo %}Tienda{% endblock %}
{% block content %}

<section class="bg-dark text-white text-center py-5">
    <div class="container">
        <h1 class="display-5 fw-bold">Tienda Megadiseños</h1>
        <p class="lead">Productos y servicios listos para tu empresa</p>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <div class="row g-4">
            {% for producto in productos %}
            <div class="col-md-4 col-sm-6">
                <div class="card h-100 shadow-sm border-0">
                    <div class="ratio ratio-1x1 bg-light">
                        <img src="{{ producto.imagen }}" class="card-img-top" alt="{{ producto.nombre }}" style="object-fit: cover;">
                    </div>
                    <div class="card-body d-flex flex-column">
                        <span class="badge bg-warning text-dark mb-2" style="width: fit-content;">{{ producto.categoria }}</span>
                        <h5 class="fw-bold">{{ producto.nombre }}</h5>
                        {% if producto.precio %}
                        <p class="fs-5 fw-bold text-dark mt-auto mb-2">${{ "{:,.0f}".format(producto.precio).replace(",", ".") }} CLP</p>
                        {% else %}
                        <p class="fs-6 fw-bold text-secondary mt-auto mb-2">Cotizar</p>
                        {% endif %}
                        <button class="btn btn-warning fw-bold w-100">
                            <i class="fa fa-cart-plus me-2"></i>Agregar al carrito
                        </button>
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
</section>

{% endblock %}
