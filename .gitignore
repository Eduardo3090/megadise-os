.vs/

# Entorno / credenciales
.env
venv/
.venv/

# Python
__pycache__/
*.pyc

# Base de datos local (contiene emails/IPs de clientes, no debe subirse)
*.db
megadisenos/suscriptores.db
megadisenos/contenido.db

# Clave secreta autogenerada para las sesiones del panel /admin
megadisenos/.secret_key

# Imágenes subidas desde el panel /admin (se generan en el servidor)
megadisenos/static/uploads/*
!megadisenos/static/uploads/.gitkeep
